# Copy to /etc/agent-replay/service.env and replace secrets there.
AGENT_REPLAY_DB=/var/lib/agent-replay/control.db
AGENT_REPLAY_HOST=127.0.0.1
AGENT_REPLAY_PORT=8791

# Test harness identity only. Replace with OAuth/ChatGPT identity in production.
AGENT_REPLAY_TEST_IDENTITY_SECRET=replace-with-a-long-random-secret

# Never commit live Stripe keys here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

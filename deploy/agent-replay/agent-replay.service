[Unit]
Description=Agent Replay hosted service
After=network.target

[Service]
Type=simple
User=agentreplay
Group=agentreplay
WorkingDirectory=/opt/agent-replay/current/service
EnvironmentFile=/etc/agent-replay/service.env
Environment=PYTHONPATH=/opt/agent-replay/current/src:/opt/agent-replay/current/service
ExecStart=/opt/agent-replay/current/.venv/bin/python -m agent_replay_service.dev_server
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/agent-replay /run/agent-replay
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
CPUQuota=100%
TasksMax=32
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

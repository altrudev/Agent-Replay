{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agent-replay.dev/schemas/public-aps-authority-v1.schema.json",
  "title":"Agent Replay Public APS Authority v1",
  "type":"object",
  "required":["schema","source_schema","source_input_sha256","adapter_tested_revision","external_conformance","identity","authority","policy","binding","execution","evidence_boundary","redaction"],
  "properties":{
    "schema":{"const":"agent-replay.public-aps-authority.v1"},
    "source_schema":{"const":"agent-replay.aps-authority-reconstruction.v1"},
    "source_input_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "adapter_tested_revision":{"type":["string","null"]},
    "external_conformance":{"type":"object"},
    "identity":{"type":"object"},
    "authority":{"type":"object"},
    "policy":{"type":"object"},
    "binding":{"type":"object"},
    "execution":{"type":"object"},
    "evidence_boundary":{"type":"object","properties":{"permit_is_execution":{"const":false}}},
    "redaction":{"type":"object","required":["identities_pseudonymized","raw_receipts_omitted","raw_delegations_omitted","raw_execution_events_omitted"]}
  }
}